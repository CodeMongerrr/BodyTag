# Copy to .env (gitignored). Compose defaults HOSTED_FEE_BPS=0 (self-host, free).
# Official hosted instance: HOSTED_FEE_BPS=100 (1% of winning GMV from Stake).

NODE_ENV=development
APP_URL=http://localhost:3000
SHORT_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://bodytag:bodytag@localhost:5432/bodytag
REDIS_URL=redis://localhost:6379

# 0 = self-host (no BodyTag cut). 100 = 1.00% hosted service fee from Stake.
HOSTED_FEE_BPS=0
REQUIRE_STAKE=false
ENABLE_MARKETPLACE_GRID=true
TRADEMARK_NAME=BodyTag

# mock | dodo | stripe | razorpay
PAYMENT_PROVIDER=mock
# Mock checkout normally only works outside NODE_ENV=production; set true on a public demo instance.
ALLOW_MOCK_PAYMENTS=false
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
# Pay-what-you-want products from the Dodo dashboard (Products > Create > Pay what you want, min 1 USD).
DODO_BID_PRODUCT_ID=
DODO_STAKE_PRODUCT_ID=
# Comma-separated checkout methods. Empty = launch set (cards, Apple/Google Pay, UPI, iDEAL, Bancontact, EPS, P24, BLIK).
DODO_PAYMENT_METHODS=
# Keep false. Live-mode bids on the platform Dodo key would make BodyTag collect brand money (docs/dodo-compliance.md).
ALLOW_PLATFORM_COLLECTED_BIDS=false

# fs (local OSS) | s3 (MinIO / R2)
STORAGE_DRIVER=fs
STORAGE_DIR=../../data/objects
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bodytag
S3_ACCESS_KEY=bodytag
S3_SECRET_KEY=bodytagsecret
CDN_BASE_URL=

# Image worker
IMAGE_QUEUE=bodytag-images
PLAYWRIGHT_SNAPSHOTS=false

# Avaturn (free tier): project subdomain from developer.avaturn.me. "demo" works for local dev.
NEXT_PUBLIC_AVATURN_SUBDOMAIN=demo

# Optional hosted chat
CRISP_WEBSITE_ID=
SUPPORT_EMAIL=support@bodytag.app
CREATORS_EMAIL=creators@bodytag.app

# Legal identity printed on /terms and /privacy. Unset values show as visible [placeholders].
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_GOVERNING_LAW=
PRIVACY_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
EU_REPRESENTATIVE=
